# Скопируйте в backend/.env и заполните. backend/.env в git не коммитится.

# GET-ссылка организаторов БЕЗ group_id (group_id подставляется сервером из query).
DATASET_URL=https://<organizers-host>/powerautomate/automations/direct/.../invoke?api-version=1&sp=...&sv=1.0&sig=<SECRET>

# LLM: auto = Claude, если есть ключ, иначе rule-based; rules = только правила; anthropic = только Claude
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_EFFORT=low
# цены $/1M токенов для расчёта стоимости (sonnet-5-5: 2/10, opus-5-5: 4/20, haiku-5-5: 0.10/0.50)
LLM_PRICE_IN=2.0
LLM_PRICE_OUT=10.0
# чтение кэша промпта, $/1M (sonnet-5-5: 0.20; opus-5-5: 0.20; haiku-5-5: ~0.01)
LLM_PRICE_CACHE_READ=0.20
LLM_MAX_WORKERS=8
# per_criterion (8 независимых вызовов, кэш префикса) | single_call (все критерии одним вызовом; для бесплатного Gemini)
LLM_STRATEGY=single_call
# голосование: N прочтений диалога, по каждому критерию ответ большинства; расхождение -> ручная проверка
LLM_VOTES=3
# 1 = кэшировать ответы модели: повторная оценка и замена одного критерия не оплачивают остальные заново
LLM_RESULT_CACHE=1
LLM_TIMEOUT_SEC=120
LLM_MAX_RETRIES=3

# Бесплатный вариант: OpenAI-совместимый провайдер (по умолчанию Gemini из Google AI Studio).
# auto: Claude, если есть ANTHROPIC_API_KEY; иначе этот провайдер, если есть OPENAI_COMPAT_API_KEY; иначе правила.
OPENAI_COMPAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_COMPAT_API_KEY=
# точное имя модели: python -m ml.live_smoke --list-models
# gemini-flash-latest 2026-11-08 был перегружен (503); flash-lite отвечал за ~4 с
OPENAI_COMPAT_MODEL=gemini-flash-lite-latest
# запасная модель со своей дневной квотой (бесплатно 500 запросов/сутки на модель): при исчерпании основной
# переключение сразу, без ожидания; на ней одно прочтение вместо голосования (она медленнее)
OPENAI_COMPAT_FALLBACK_MODEL=gemini-3.8-flash
# пауза между запросами (бесплатный лимит ~15 запросов/мин -> 4 с)
OPENAI_COMPAT_MIN_INTERVAL_SEC=4
OPENAI_COMPAT_PRICE_IN=0
OPENAI_COMPAT_PRICE_OUT=0

# SQLite (по умолчанию data/cqa.db)
# CQA_DB_PATH=data/cqa.db
