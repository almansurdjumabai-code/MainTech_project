# Скопируйте в backend/.env и заполните. backend/.env в git не коммитится.

# GET-ссылка организаторов БЕЗ group_id (group_id подставляется сервером из query).
DATASET_URL=https://<organizers-host>/powerautomate/automations/direct/.../invoke?api-version=1&sp=...&sv=1.0&sig=<SECRET>

# LLM: auto = Claude, если есть ключ, иначе rule-based; rules = только правила; anthropic = только Claude
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_EFFORT=low
# цены $/1M токенов для расчёта стоимости (sonnet-5-5: 2/10, opus-5-5: 4/20, haiku-5-5: 0.10/0.50)
LLM_PRICE_IN=2.0
LLM_PRICE_OUT=10.0
# чтение кэша промпта, $/1M (sonnet-5-5: 0.20; opus-5-5: 0.20; haiku-5-5: ~0.01)
LLM_PRICE_CACHE_READ=0.20
LLM_MAX_WORKERS=8
# per_criterion (8 независимых вызовов, кэш префикса) | single_call (все критерии одним вызовом, дешевле)
LLM_STRATEGY=per_criterion
# 1 = кэшировать ответы модели: повторная оценка и замена одного критерия не оплачивают остальные заново
LLM_RESULT_CACHE=1
LLM_TIMEOUT_SEC=120
LLM_MAX_RETRIES=3

# SQLite (по умолчанию data/cqa.db)
# CQA_DB_PATH=data/cqa.db
