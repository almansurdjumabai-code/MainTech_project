# Скопируйте в backend/.env и заполните. backend/.env в git не коммитится.

# GET-ссылка организаторов БЕЗ group_id (group_id подставляется сервером из query).
DATASET_URL=https://<organizers-host>/powerautomate/automations/direct/.../invoke?api-version=1&sp=...&sv=1.0&sig=<SECRET>

# LLM: auto = Claude, если есть ключ, иначе rule-based; rules = только правила; anthropic = только Claude
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
# цены $/1M токенов для расчёта стоимости (opus-5-5: 4/20, haiku-5-5: 0.10/0.50)
LLM_PRICE_IN=4.0
LLM_PRICE_OUT=20.0
LLM_MAX_WORKERS=8

# SQLite (по умолчанию data/cqa.db)
# CQA_DB_PATH=data/cqa.db
