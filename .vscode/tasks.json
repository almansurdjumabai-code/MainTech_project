{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CQA: run server",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe -m uvicorn backend.app.main:app --reload --port 8000",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "CQA: tests",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe -m pytest -q",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "CQA: ingest + batch DEV",
      "type": "shell",
      "command": "curl.exe -X POST 'http://127.0.0.1:8000/ingest?group_id=DEV'; curl.exe -X POST http://127.0.0.1:8000/evaluate/batch -H 'Content-Type: application/json' -d '{\\\"group_id\\\":\\\"DEV\\\",\\\"checklist_id\\\":\\\"cqa-default-v1\\\"}'",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
